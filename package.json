{
  "name": "git-scrivener",
  "version": "0.1.0",
  "private": true,
  "description": "Generate Conventional Commit messages from staged Git changes using OpenAI or Anthropic.",
  "type": "module",
  "bin": {
    "git-scrivener": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:bundle": "SCRIVENER_TEST_CLI=./dist/cli.js node --test test/cli.test.ts test/lazy-loading.test.ts test/bundle.integration.ts",
    "lint": "oxlint src test tsdown.config.ts",
    "format": "oxfmt --write src test tsdown.config.ts",
    "format:check": "oxfmt --check src test tsdown.config.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "openai": "7.42.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  }
}
